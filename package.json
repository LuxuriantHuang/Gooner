{
  "name": "gooner",
  "version": "0.1.0",
  "description": "A local, user-controlled media popup tool for Windows.",
  "main": "src/main/main.js",
  "scripts": {
    "build:native": "node scripts/build-desktop-host.js",
    "test:wallpaper-focus": "node --test test/wallpaper-focus-state.test.js",
    "test:peer-share": "node --test test/peer-share-protocol.test.js",
    "predev": "npm run build:native",
    "dev": "electron .",
    "prestart": "npm run build:native",
    "start": "electron .",
    "predist": "npm run build:native",
    "dist": "electron-builder --win",
    "predist:cn": "npm run build:native",
    "dist:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win",
    "lint:i18n": "node scripts/lint-i18n.js"
  },
  "keywords": [
    "electron",
    "media",
    "popup"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.gooner",
    "productName": "Gooner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/native/desktop-host.exe"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "bittorrent-dht": "^10.0.7",
    "image-size": "^1.1.1",
    "simple-peer": "^9.11.1"
  }
}
